# Proxy cache zone for API and report responses. Declared at http level (this
# file is included inside nginx's http {} block via conf.d). TTLs are driven
# entirely by upstream Cache-Control headers; no proxy_cache_valid override.
# Cache dir is created by the Dockerfile RUN step.
proxy_cache_path /var/cache/nginx/webres6
    levels=1:2
    keys_zone=webres6:4m
    max_size=${NGINX_CACHE_MAX_SIZE}
    inactive=7d
    use_temp_path=off;

server {
    listen [::]:${NGINX_PORT};
    listen 0.0.0.0:${NGINX_PORT};
    listen unix:/var/run/nginx.webres6.sock;

    merge_slashes off;
    rewrite ^/+(.*)$ /$1;
    root /usr/share/nginx/html;
    server_tokens off;

    # gzip compression for text-based responses. text/html is compressed
    # implicitly; already-compressed assets (woff2/woff, png/ico) are omitted.
    # gzip_vary adds "Vary: Accept-Encoding" so caches key on it; gzip_proxied any
    # also compresses proxied API/report responses.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/html text/css application/javascript application/json
               application/manifest+json image/svg+xml application/xml text/xml;

    # Security headers. Set at server level with `always` so they also apply to
    # error pages. NOTE: `add_header` inside a `location` cancels all inherited
    # `add_header`s, so cache lifetimes below use `expires` (a separate directive)
    # instead of `add_header Cache-Control` to avoid stripping these headers from
    # CSS/JS/HTML/report responses.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    # connect-src must include the archive location for direct report loading when
    # reports are delivered from S3 (public/presigned) or a CDN; fetch() enforces
    # connect-src across redirect hops, so the presigned 302 target needs it too.
    # WEBRES6_ARCHIVE_SRC is a CSP source scoped to the bucket path (trailing "/"
    # = prefix match) so only our bucket is allowed, not the whole S3 endpoint.
    # It is empty for same-origin (local/valkey/private) setups.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' blob:; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${WEBRES6_ARCHIVE_SRC}; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;

    location / {
        index viewer.html;
    }
    location ~* \.(png|ico|woff|woff2)$ {
      expires 604800s;
    }
    location ~* \.(css|js|html)$ {
      expires 5400s;
    }
    location ~ ^/res6/report/(?<id>[a-z0-9-]+)$ {
      expires 604800s;
      try_files /res6/report/report-$id.json @api;
    }
    location /res6/ {
        proxy_pass ${WEBRES6_API_URL}/res6/;
        proxy_set_header Host $host;
        proxy_cache webres6;
        proxy_cache_lock on;
    }
    location @api {
        proxy_pass ${WEBRES6_API_URL}/$uri;
        proxy_set_header Host $host;
        proxy_cache webres6;
        proxy_cache_lock on;
    }
    location /dnsprobe/  {
        proxy_pass ${DNSPROBE_API_URL}/dnsprobe/;
        proxy_set_header Host $host;
        proxy_cache webres6;
        proxy_cache_lock on;
    }

    location = /mcp        { proxy_pass ${WEBRES6_MCP_URL}; proxy_set_header Host $host; }
    location = /mcp/       { rewrite ^ /mcp permanent; }
    location ^~ /mcp/      { proxy_pass ${WEBRES6_MCP_URL}; proxy_set_header Host $host; }

    location = /404.html { internal; }
    location = /50x.html { internal; }
    location = /disabled.html { internal; }
    error_page  404               /404.html;
    error_page  500 502 503 504   /50x.html;
}
upstream webres6-viewer {
    server unix:/var/run/nginx.webres6.sock;
}

server {
    listen unix:/var/run/nginx.disabled.sock;
    root /usr/share/nginx/html;
    rewrite ^/(.*)$ /disabled.html;
}
upstream disabled {
    server unix:/var/run/nginx.disabled.sock;
}
